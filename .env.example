NEO4J_URI=neo4j+s://example.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-aura-password
NEO4J_DATABASE=neo4j
NEO4J_TRUST_SELF_SIGNED=false
GRAPH_PERSISTENCE_ENABLED=false
NEO4J_SYNC_ENABLED=false
GRAPH_INCLUDE_PII=false
RDS_SYNC_DATABASE_URL=jdbc:postgresql://example.rds.amazonaws.com:5432/fitback
RDS_SYNC_USERNAME=postgres
RDS_SYNC_PASSWORD=replace-with-rds-password
RDS_SYNC_BATCH_SIZE=100
AURA_INSTANCEID=optional-instance-id
AURA_INSTANCENAME=optional-instance-name

AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_TIMEOUT_SECONDS=25

# Backward-compatible alias. Prefer OPENAI_API_KEY for new setups.
AI_API_KEY=
